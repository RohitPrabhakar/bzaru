# BZARU Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# API Configuration
API_BASE_URL=https://your-api-url.com/api/v1

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Links
APP_LINK=https://bzaru.com/
PRIVACY_TERMS_LINK=https://bzaru.com/privacy-policy

# Firebase Configuration (if using REST API)
# Note: Keep google-services.json and GoogleService-Info.plist secure and local
FIREBASE_PROJECT_ID=your_project_id
